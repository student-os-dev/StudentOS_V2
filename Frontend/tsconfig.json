{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "ES2022",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "jsx":  "react-jsx",
                            "strict":  true,
                            "skipLibCheck":  true,
                            "noEmit":  true,
                            "verbatimModuleSyntax":  true,
                            "isolatedModules":  true,
                            "noUnusedLocals":  true,
                            "noUnusedParameters":  true,
                            "noFallthroughCasesInSwitch":  true,
                            "noUncheckedIndexedAccess":  true,
                            "types":  [
                                          "vite/client",
                                          "node"
                                      ],
                            "allowImportingTsExtensions":  true
                        },
    "include":  [
                    "src",
                    "vite.config.ts"
                ]
}