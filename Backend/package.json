{
  "name": "student-os-v2-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fictional Transport Department RAG backend prototype",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "index": "node --env-file-if-exists=.env scripts/index-knowledge.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "node --test tests/rag.test.ts tests/api.test.ts tests/database.test.ts tests/admin.test.ts tests/knowledge-management.test.ts",
    "db:migrate": "node scripts/migrate-database.ts",
    "db:import-transport": "node scripts/import-transport.ts",
    "db:inspect": "node scripts/inspect-database.ts",
    "test:database": "node --test tests/database.test.ts",
    "admin:provision": "node scripts/provision-administrator.ts",
    "test:admin": "node --test tests/admin.test.ts",
    "test:knowledge": "node --test tests/knowledge-management.test.ts"
  },
  "dependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
