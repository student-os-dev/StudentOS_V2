# Native Node.js environment-file support; no dotenv dependency.
HOST=127.0.0.1
PORT=3000
OLLAMA_BASE_URL=http://localhost:11434
ANSWER_MODEL=qwen3:4b
# Approved workaround for the installed thinking-only Qwen3 variant; see README.
GENERATION_MODE=qwen3-prefill
EMBEDDING_MODEL=nomic-embed-text
RELEVANCE_THRESHOLD=0.70
TOP_K=2
MAX_CONTEXT_CHARS=1200
NUM_CTX=2048
MAX_OUTPUT_TOKENS=160
TEMPERATURE=0
NUM_THREAD=4
NUM_BATCH=128
KEEP_ALIVE=2m
# Keep the small embedding model on CPU to reserve the 4 GB GPU for Qwen.
EMBED_NUM_GPU=0
EMBED_KEEP_ALIVE=2m
OLLAMA_TIMEOUT_MS=120000
MAX_QUESTION_CHARS=500

# Administrator authentication (development origins only).
# Production requires NODE_ENV=production and explicit HTTPS ADMIN_ORIGINS.
ADMIN_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Enable only behind an explicitly trusted loopback TLS reverse proxy.
ADMIN_TRUST_LOOPBACK_PROXY=0
